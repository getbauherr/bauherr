{
  "name": "server",
  "private": true,
  "version": "0.1.0-rc.1",
  "type": "module",
  "scripts": {
    "predev": "pnpm gen:migrations && pnpm tokens && pnpm build:widget",
    "dev": "next dev --port 3000",
    "prebuild": "pnpm gen:migrations && pnpm tokens && pnpm build:widget",
    "build": "next build",
    "start": "next start",
    "jobs": "tsx scripts/jobs-runs.ts",
    "jobs:poll": "tsx scripts/reclaim-orphans.ts; payload jobs:run --queue poll --handle-schedules --cron \"*/5 * * * * *\"",
    "importmap": "payload generate:importmap",
    "seed:e2e": "tsx scripts/seed-e2e.ts",
    "seed": "tsx scripts/seed-workspace0.ts",
    "session:activate": "tsx scripts/session-activate.ts activate",
    "session:deactivate": "tsx scripts/session-activate.ts deactivate",
    "pretypecheck": "pnpm gen:migrations",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm gen:migrations",
    "test": "vitest run",
    "test:gateway": "vitest run --config vitest.integration.config.ts",
    "test:mcp": "tsx --test --test-force-exit tests/mcp.e2e.ts",
    "gen:migrations": "tsx scripts/gen-migrations.ts",
    "tokens": "tsx scripts/tokens.ts",
    "build:widget": "tsx scripts/build-widget.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.32",
    "@assistant-ui/react-markdown": "0.14.25",
    "@bauherr/adapters": "workspace:*",
    "@bauherr/eval": "workspace:*",
    "@bauherr/runner": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@payloadcms/db-postgres": "3.92.1",
    "@payloadcms/next": "3.92.1",
    "@payloadcms/plugin-multi-tenant": "3.92.1",
    "@payloadcms/storage-s3": "3.92.1",
    "@radix-ui/react-avatar": "1.3.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tooltip": "1.4.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "croner": "10.0.1",
    "graphql": "^16.11.0",
    "marked": "^18.1.2",
    "next": "16.4.3",
    "openid-client": "^6.8.8",
    "payload": "3.92.1",
    "pg": "^8.16.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-shiki": "0.11.2",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.7.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "^24",
    "@types/pg": "^8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "0.28.2",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  }
}
