# yaml-language-server: $schema=https://agentgateway.dev/schema/config
# Rendered by the compose `init` service on first start; afterwards Bauherr owns llm.models
# (apps/server/src/lib/gateway.ts) and keys live in the gateway database (hybrid storage).
config:
  adminAddr: "0.0.0.0:15000" # unauthenticated: never publish this port
  storage:
    mode: hybrid
  database:
    url: "__GATEWAY_DATABASE_URL__"
  modelCatalog:
  - file: /gateway/catalogs/anthropic.json
  metrics:
    fields:
      add:
        user_id: apiKey.user
  __TRACING__
gateways:
  default:
    port: 4000
frontendPolicies:
  accessLog:
    database:
      llm: metadata
      add:
        run: 'request.headers["x-bauherr-run"]'
        stage: 'request.headers["x-bauherr-stage"]'
        product: 'request.headers["x-bauherr-product"]'
        ticket: 'request.headers["x-bauherr-ticket"]'
llm:
  gateways: default
  policies:
    apiKey:
      mode: strict
      # Session keys arrive in x-agw-key (Claude Code ANTHROPIC_CUSTOM_HEADERS) so Authorization stays free for sub/*;
      # the Runner proxy sends the Workspace key as Authorization: Bearer. An expression location deletes nothing.
      location:
        expression: 'coalesce(request.headers["x-agw-key"], request.headers["authorization"].stripPrefix("Bearer "))'
      keys: []
  # Bauherr owns only the ws-<slug>/* entries (apps/server/src/lib/gateway.ts); sub/* stays as rendered here.
  models:
  # Owner's own Claude Code session (docs/legal.md). No params.apiKey: that would win over auth and bill the Workspace
  # credential. The caller's Authorization header is forwarded upstream; it is never stored (accessLog adds only the
  # fields above, database.llm stays metadata). Only keys created by ensureSessionKey may use it.
  - name: "sub/*"
    provider: anthropic
    auth:
      passthrough:
        location:
          header:
            name: authorization
            prefix: "Bearer "
    transformation:
      model: llmRequest.model.stripPrefix("sub/")
    authorization:
      rules:
      - allow: 'apiKey.kind == "owner-session"'
    requestHeaders:
      remove:
      - x-agw-key
