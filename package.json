{
  "name": "bauherr-monorepo",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "screenshots": "bash scripts/screenshots.sh",
    "build:packages": "pnpm --filter @bauherr/adapters --filter @bauherr/runner --filter @bauherr/eval build",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "test": "pnpm build:packages && pnpm -r test"
  },
  "devDependencies": {
    "@google/design.md": "0.4.0",
    "@playwright/test": "^1.64.1"
  }
}
