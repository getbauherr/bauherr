{
  "name": "bauherr-monorepo",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:packages": "pnpm --filter @bauherr/adapters --filter @bauherr/runner build",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "lint": "pnpm build:packages && eslint .",
    "prepare": "[ -z \"$CI\" ] && git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "test": "pnpm build:packages && pnpm -r test"
  },
  "devDependencies": {
    "@google/design.md": "0.4.0",
    "@playwright/test": "^1.64.1",
    "eslint": "10.14.0",
    "typescript-eslint": "8.72.1"
  }
}
